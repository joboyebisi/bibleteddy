# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (Video2App engine + quiz fallback)
GEMINI_API_KEY=

# YouVersion Platform — App Key from https://platform.youversion.com
# Used for Bible API (X-YVP-App-Key) and OAuth client_id
YOUVERSION_APP_KEY=
# Legacy alias (optional)
YVP_APP_KEY=
YOUVERSION_API_TOKEN=

# YouVersion OAuth callback — must match Platform Portal exactly
# Recommended (client page, handles hash fragments):
#   https://bibleteddy.vercel.app/onboarding/youversion/callback
# Alternative API route:
#   https://bibleteddy.vercel.app/api/youversion/callback
YOUVERSION_REDIRECT_URI=https://bibleteddy.vercel.app/onboarding/youversion/callback
YOUVERSION_SCOPES=openid profile email
YOUVERSION_API_BASE=https://api.youversion.com/v1

# Gloo AI Studio
GLOO_API_KEY=
GLOO_API_BASE=https://api.studio.gloo.us/v1

# App URL (required for OAuth redirects and internal API calls)
# Production: https://bibleteddy.vercel.app
# Local dev:  http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
