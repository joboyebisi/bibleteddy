# Supabase — get from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini
GEMINI_API_KEY=

# YouVersion — App Key from https://platform.youversion.com (same value for all three aliases)
YOUVERSION_APP_KEY=
YOUVERSION_API_TOKEN=
YVP_APP_KEY=

# YouVersion — register this callback at https://platform.youversion.com
# (built automatically from NEXT_PUBLIC_SITE_URL — do not set YOUVERSION_REDIRECT_URI)
# Production: https://bibleteddy.vercel.app/onboarding/youversion/callback

# Production site URL (prevents OAuth redirecting to localhost)
NEXT_PUBLIC_SITE_URL=https://bibleteddy.vercel.app

YOUVERSION_SCOPES=openid profile email
YOUVERSION_API_BASE=https://api.youversion.com/v1

# Gloo AI Studio
GLOO_API_KEY=
GLOO_API_BASE=https://api.studio.gloo.us/v1

# Local dev only — uncomment when testing locally:
